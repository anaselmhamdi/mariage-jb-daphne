FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:alpine
COPY --from=build /app/dist/civil.html /srv/index.html
COPY --from=build /app/dist/images /srv/images
COPY --from=build /app/dist/_astro /srv/_astro
EXPOSE 8080
CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":8080"]
