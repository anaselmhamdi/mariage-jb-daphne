---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daphné & Jean-Baptiste — {title}</title>
  <meta name="description" content="Mariage civil de Daphné & Jean-Baptiste, samedi 20 juin 2026, Asnières-sur-Seine">
  <meta property="og:title" content={`Daphné & Jean-Baptiste — ${title}`}>
  <meta property="og:description" content="Mariage civil · Samedi 20 juin 2026 · Asnières-sur-Seine">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <slot />
</body>
</html>
