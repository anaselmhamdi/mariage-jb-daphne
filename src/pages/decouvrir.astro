---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const incontournables = [
  { img: '/images/galerie-art.png', title: 'Les galeries d\'art', description: 'Flânez dans les ruelles pavées et découvrez les nombreuses galeries qui font la renommée de la cité des peintres' },
  { img: '/images/promenade-aven.avif', title: 'Promenade le long de l\'Aven', description: 'Balade romantique au bord de la rivière' },
  { img: '/images/galettes-pont-aven.jpg', title: 'Les galettes de Pont-Aven', description: 'Après les avoir goûtées, vous n\'appellerez plus "galettes" nos succulentes "crêpes" de blé noir. Goûtez et élisez votre meilleure galette : plutôt Traou Mad ou Isidore Penven ?' },
  { img: '/images/musee-pont-aven.jpg', title: 'Musée de Pont-Aven', description: 'Sur les traces de Gauguin et de l\'École de Pont-Aven - un musée incontournable' },
  { img: '/images/bois-damour.webp', title: 'Bois d\'Amour', description: 'Promenade bucolique à 5 min à pied du centre, lieu d\'inspiration des peintres impressionnistes' },
];

const alentours = [
  { img: '/images/plages-bretagne.png', title: 'Les plages', description: 'Les plages de Nevez (plage de Tahiti, Saint Nicolas, Dourveil) et Trégunc (Trescao, Feunteun Aodou, Pouldohan) sont à 10 min de Pont-Aven et parmi les plus belles de Bretagne (après celles de Plouguerneau)' },
  { img: '/images/concarneau.jpg', title: 'Concarneau', description: 'Cité fortifiée médiévale entourée de remparts, port de pêche et restaurants de fruits de mer (15 min)' },
  { img: '/images/quimperle.jpeg', title: 'Quimperlé', description: 'Charmante cité médiévale au confluent de deux rivières, avec ses ruelles et maisons à pans de bois (20 min)' },
];
---

<BaseLayout title="Découvrir Pont-Aven" activePage="decouvrir">
  <PageHeader title="Découvrir Pont-Aven" subtitle="Profitez de votre séjour pour découvrir Pont-Aven, la &quot;Cité des Peintres&quot; qui a inspiré Gauguin, et ses environs magnifiques." />

  <section class="page-content">
    <div class="container-narrow">
      <div class="discover-section">
        <h2 class="section-title-left">Incontournables à Pont-Aven</h2>
        <div class="activity-list">
          {incontournables.map((item) => (
            <div class="activity-item fade-in">
              <div class="activity-img">{item.img ? <img src={item.img} alt={item.title} /> : item.emoji}</div>
              <div class="activity-text">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="discover-section">
        <h2 class="section-title-left">Aux alentours</h2>
        <div class="activity-list">
          {alentours.map((item) => (
            <div class="activity-item fade-in">
              <div class="activity-img">{item.img ? <img src={item.img} alt={item.title} /> : item.emoji}</div>
              <div class="activity-text">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="info-box">
        <h3>Plus d'informations</h3>
        <p><a href="https://www.pontaven.com/" target="_blank" class="external-link">Office de Tourisme de Pont-Aven</a></p>
        <p><a href="https://www.deconcarneauapontaven.com/" target="_blank" class="external-link">Office de tourisme Concarneau Pont-Aven</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-content { padding: 80px 20px; }
  .discover-section { margin-bottom: 60px; }

  .activity-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
  }

  .activity-item {
    background: var(--color-white);
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow: hidden;
  }

  .activity-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  .activity-img {
    width: 100%;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    background: linear-gradient(135deg, #B6AEFB 0%, #D5D0FD 100%);
    overflow: hidden;
  }

  .activity-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .activity-text {
    padding: 20px 24px 24px;
  }

  .activity-item h3 {
    font-size: 18px;
    color: var(--color-dark);
    margin-bottom: 8px;
    font-family: var(--font-heading);
  }

  .activity-item p {
    font-size: 14px;
    color: var(--color-text);
    margin: 0;
    line-height: 1.6;
  }

  .info-box {
    background: var(--color-lavender-light);
    padding: 30px 40px;
    border-radius: 15px;
    text-align: center;
    border: 2px solid var(--color-lavender);
  }

  .info-box h3 {
    font-size: 22px;
    color: var(--color-dark);
    margin-bottom: 15px;
  }
</style>
