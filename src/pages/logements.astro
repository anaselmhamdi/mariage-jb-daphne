---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Logements & Transport" activePage="logements">
  <PageHeader title="Logements & Transport" />

  <section class="page-content">
    <div class="container-narrow">
      <div class="intro-text">
        <p>Pour profiter pleinement du week-end sans vous soucier de la route, nous vous recommandons vivement de prévoir un hébergement sur place. Voici une sélection d'options à Pont-Aven et ses environs.</p>
        <p><strong>Conseil important :</strong> Réservez au plus tôt ! Octobre est une période prisée en Bretagne et les disponibilités sont limitées.</p>
      </div>

      <!-- Hôtels -->
      <div class="accommodation-category">
        <h2 class="section-title-left">Hôtels & Chambres d'hôtes</h2>

        <div class="accommodation-item featured fade-in">
          <div class="featured-badge">Tarif négocié</div>
          <h3>La Pension du Moulin</h3>
          <p class="accommodation-details">25 chambres</p>
          <p class="contact-info">Téléphone : <a href="tel:0298060206">02 98 06 02 06</a></p>
          <p><a href="https://lapensiondumoulin.com/en/home/" target="_blank" class="external-link">Site web</a></p>
          <div class="special-offer">
            <h4>Offre spéciale pour nos invités :</h4>
            <p>-10% de réduction pour toute réservation de 2 nuits minimum</p>
            <p class="offer-note">Précisez "Mariage Delaunay" lors de votre réservation pour bénéficier de la réduction</p>
          </div>
        </div>

        <div class="accommodation-item featured fade-in">
          <div class="featured-badge">Tarif négocié</div>
          <h3>Vacancéole - Les Rives de Pont-Aven</h3>
          <p class="accommodation-details">Studios et appartements</p>
          <p class="contact-info">Téléphone : <a href="tel:0479757520">04 79 75 75 20</a></p>
          <p><a href="https://www.vacanceole.com/location-vacances/311-residence-les-rives-de-pont-aven-pont-aven" target="_blank" class="external-link">Site web</a></p>
          <div class="special-offer">
            <h4>Offre spéciale pour nos invités :</h4>
            <p>-10% de réduction avec le code <strong>MARIAGEDELAUNAY</strong></p>
            <p class="offer-note">Valable pour les réservations effectuées avant le 1er octobre 2026, pour un séjour du 1 au 4 octobre (minimum 2 nuits)</p>
            <p class="offer-note">Réservations par téléphone ou directement sur le site</p>
          </div>
        </div>

        <div class="accommodation-item fade-in">
          <h3>La Chaumière Roz Aven</h3>
          <p class="accommodation-details">14 chambres</p>
          <p class="contact-info">Téléphone : <a href="tel:0298061306">02 98 06 13 06</a></p>
          <p><a href="https://www.hotelpontaven.com/" target="_blank" class="external-link">Site web</a></p>
        </div>

        <div class="accommodation-item fade-in">
          <h3>Les Mimosas</h3>
          <p class="accommodation-details">10 chambres</p>
          <p class="contact-info">Téléphone : <a href="tel:0298060030">02 98 06 00 30</a></p>
          <p><a href="https://www.lesmimosas-pontaven.com/" target="_blank" class="external-link">Site web</a></p>
        </div>

        <div class="accommodation-item fade-in">
          <h3>Résidence Goelia - Domaine de Pont-Aven</h3>
          <p class="accommodation-details">Studios, appartements et maisons (2 à 6 personnes)</p>
          <p class="contact-info">Téléphone : <a href="tel:0298099360">02 98 09 93 60</a></p>
          <p><a href="https://www.goelia.com/fr/residence-vacances/pont-aven/residence-goelia-le-domaine-de-pont-aven.410.4.php" target="_blank" class="external-link">Site web</a></p>
          <p class="tip-text">Conseil : Appelez directement pour réserver. Plus vous réservez tôt, plus les tarifs sont avantageux.</p>
        </div>
      </div>

      <!-- Maisons d'hôtes -->
      <div class="accommodation-category">
        <h2 class="section-title-left">Maisons d'hôtes & Locations</h2>

        <div class="accommodation-item fade-in">
          <h3>Les Chambres de l'Atelier</h3>
          <p class="accommodation-details">1 chambre disponible</p>
          <p><a href="https://www.booking.com/hotel/fr/les-chambres-de-l-39-atelier.fr.html" target="_blank" class="external-link">Réserver sur Booking.com</a></p>
        </div>

        <div class="accommodation-item fade-in">
          <h3>Chez Yann & Valérie</h3>
          <p class="accommodation-details">Appartements</p>
          <p><a href="https://chezyannetvalerie.com/" target="_blank" class="external-link">Site web</a></p>
        </div>

        <div class="accommodation-item fade-in">
          <h3>Chez Patrick et Virginie</h3>
          <p class="accommodation-details">Maison 4 personnes</p>
          <p><a href="https://www.booking.com/hotel/fr/chez-patrick-et-virginie.fr.html" target="_blank" class="external-link">Réserver sur Booking.com</a></p>
        </div>

        <div class="accommodation-item fade-in">
          <h3>Maison Castel Braz</h3>
          <p><a href="https://castelbraz.com/" target="_blank" class="external-link">Site web</a></p>
        </div>
      </div>

      <!-- Camping -->
      <div class="accommodation-category">
        <h2 class="section-title-left">Camping</h2>

        <div class="accommodation-item fade-in">
          <h3>Domaine de Kerlann</h3>
          <p class="accommodation-details">Plusieurs mobil-homes disponibles</p>
          <p class="contact-info">Téléphone : <a href="tel:0298060177">02 98 06 01 77</a></p>
          <p><a href="https://www.deconcarneauapontaven.com/campings/le-domaine-de-kerlann/" target="_blank" class="external-link">Site web</a></p>
          <p class="tip-text">Option idéale pour les groupes ! Possibilité d'organiser une navette selon la demande.</p>
        </div>
      </div>

      <!-- Autres options -->
      <div class="other-options">
        <h2 class="section-title-left">Autres options</h2>
        <p>Pour encore plus de choix, consultez également :</p>
        <ul>
          <li><strong>Airbnb / Abritel</strong> - Nombreuses locations dans Pont-Aven et alentours</li>
          <li><strong>Gîtes de France Finistère</strong> - Locations de charme en Bretagne</li>
          <li><strong>Booking.com</strong> - Recherche "Pont-Aven" pour d'autres établissements</li>
        </ul>
      </div>

      <!-- Transport -->
      <div class="transport-section">
        <h2 class="section-title-left">Comment venir à Pont-Aven ?</h2>

        <div class="transport-grid">
          <div class="transport-item">
            <h3>En avion</h3>
            <p><strong>Aéroport de Quimper-Cornouaille</strong> (30 minutes)</p>
            <p><strong>Aéroport de Brest-Bretagne</strong> (1h15)</p>
            <p class="transport-note">Location de voiture recommandée à l'arrivée</p>
          </div>
          <div class="transport-item">
            <h3>En train</h3>
            <p><strong>Gare de Quimper</strong> (30 minutes de Pont-Aven)</p>
            <p><strong>Gare de Quimperlé</strong> (20 minutes de Pont-Aven)</p>
            <p class="transport-note">Location de voiture ou taxi disponibles à la gare</p>
          </div>
          <div class="transport-item">
            <h3>En voiture</h3>
            <p><strong>Depuis Paris :</strong> environ 5h30 via A11 puis N165</p>
            <p><strong>Depuis Rennes :</strong> environ 2h via N165</p>
            <p class="transport-note">Parking gratuit disponible au Manoir de Kerangosker</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-content { padding: 80px 20px; }

  .accommodation-category { margin-bottom: 70px; }
  .accommodation-category:last-child { margin-bottom: 50px; }

  .accommodation-item {
    background: var(--color-white);
    padding: 35px 40px;
    border-radius: 12px;
    margin-bottom: 25px;
    border: 2px solid var(--color-purple-light);
    border-left: 6px solid var(--color-orange);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .accommodation-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }

  .accommodation-item.featured {
    border-left-color: var(--color-purple-dark);
    position: relative;
  }

  .featured-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--color-purple-dark);
    color: var(--color-white);
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .accommodation-item h3 {
    font-size: 26px;
    color: var(--color-dark);
    font-family: var(--font-heading);
    margin-bottom: 12px;
    padding-right: 150px;
  }

  .accommodation-details {
    font-size: 17px;
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 15px;
    line-height: 1.6;
  }

  .contact-info {
    font-size: 16px;
    color: var(--color-text);
    margin-bottom: 10px;
  }

  .contact-info a {
    color: var(--color-orange);
    font-weight: 600;
  }

  .contact-info a:hover {
    color: var(--color-purple-dark);
    text-decoration: underline;
  }

  .accommodation-item .external-link {
    display: inline-block;
    font-size: 16px;
    margin-top: 5px;
  }

  .special-offer {
    background: var(--color-lavender-light);
    padding: 20px 25px;
    border-radius: 10px;
    margin-top: 20px;
    border: 2px dashed var(--color-purple-dark);
  }

  .special-offer h4 {
    font-size: 18px;
    color: var(--color-dark);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .special-offer p {
    font-size: 15px;
    color: var(--color-text);
    margin-bottom: 8px;
    line-height: 1.6;
  }

  .special-offer p:last-child { margin-bottom: 0; }

  .offer-note {
    font-size: 14px !important;
    font-style: italic;
    color: #666;
  }

  .tip-text {
    font-size: 15px;
    color: var(--color-text);
    font-style: italic;
    margin-top: 12px;
    padding: 12px 15px;
    background: var(--color-beige);
    border-radius: 8px;
    border-left: 3px solid var(--color-orange);
  }

  .other-options {
    background: var(--color-beige);
    padding: 40px;
    border-radius: 15px;
    margin-bottom: 60px;
    border-left: 6px solid var(--color-lavender);
  }

  .other-options p {
    font-size: 16px;
    color: var(--color-text);
    margin-bottom: 15px;
  }

  .other-options ul {
    list-style: none;
    padding: 0;
  }

  .other-options ul li {
    font-size: 16px;
    color: var(--color-text);
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .other-options ul li:last-child { border-bottom: none; }
  .other-options ul li strong { color: var(--color-dark); }

  .transport-section {
    background: var(--color-white);
    padding: 50px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
  }

  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
  }

  .transport-item {
    background: var(--color-beige);
    padding: 30px;
    border-radius: 12px;
    border-top: 4px solid var(--color-orange);
  }

  .transport-item h3 {
    font-size: 22px;
    color: var(--color-dark);
    font-family: var(--font-heading);
    margin-bottom: 15px;
  }

  .transport-item p {
    font-size: 16px;
    color: var(--color-text);
    margin-bottom: 10px;
    line-height: 1.6;
  }

  .transport-item p:last-child { margin-bottom: 0; }

  .transport-note {
    font-size: 14px;
    font-style: italic;
    color: #666;
    margin-top: 12px;
  }

  @media (max-width: 768px) {
    .accommodation-item { padding: 25px 20px; }
    .accommodation-item h3 { font-size: 22px; padding-right: 0; margin-bottom: 15px; }
    .featured-badge { position: static; display: inline-block; margin-bottom: 15px; }
    .special-offer { padding: 15px 20px; }
    .transport-section { padding: 30px 20px; }
    .other-options { padding: 25px 20px; }
  }
</style>
