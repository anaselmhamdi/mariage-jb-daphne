---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Confirmer sa présence" activePage="rsvp">
  <PageHeader title="Confirmer sa présence" />

  <section class="page-content">
    <div class="container-narrow">
      <div class="intro-text">
        <p>Afin de mieux organiser ce week-end et de nous assurer que tout soit parfait pour vous accueillir, merci de confirmer votre présence <strong>avant le 30 juin 2026</strong>.</p>
        <p>Précisez-nous les jours où vous serez présents et si vous avez des besoins particuliers (régime alimentaire, etc.).</p>
        <p><strong>Nous avons hâte de célébrer avec vous !</strong></p>
      </div>

      <form class="rsvp-form" id="rsvpForm">
        <!-- Informations générales -->
        <div class="form-section">
          <h2>Informations générales</h2>

          <div class="form-group">
            <label>Invités *</label>
            <p class="help-text">Ajoutez chaque personne concernée par cette réponse.</p>
            <div id="guestList"></div>
            <button type="button" id="addGuestBtn" class="btn-add-guest">+ Ajouter un invité</button>
          </div>

        </div>

        <!-- Événements -->
        <div class="form-section">
          <h2>Je confirme ma/notre présence pour : *</h2>

          <div class="checkbox-group">
            <label class="checkbox-label">
              <input type="checkbox" name="events" value="vendredi">
              <span>Vendredi 2 octobre - Cérémonie hindoue et déjeuner</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="events" value="samedi">
              <span>Samedi 3 octobre - Bénédiction à l'église, cocktail et réception</span>
            </label>
            <label class="checkbox-label">
              <input type="checkbox" name="events" value="dimanche">
              <span>Dimanche 4 octobre - Petit-déjeuner</span>
            </label>
          </div>
        </div>

        <!-- Régimes alimentaires -->
        <div class="form-section">
          <h2>Régimes alimentaires et allergies</h2>
          <div class="form-group">
            <label for="dietary">Végétarien, intolérance aux poissons/fruits de mer, autres allergies ?</label>
            <p class="help-text">Merci de préciser pour chaque personne concernée.</p>
            <textarea id="dietary" name="dietary" rows="3" placeholder="Ex : Marie - végétarienne, Lucas - intolérance aux fruits de mer"></textarea>
          </div>
        </div>

        <!-- Participation active -->
        <div class="form-section">
          <h2>Participation à la chorale</h2>

          <p class="help-text">Nous cherchons des volontaires pour former une chorale durant la bénédiction à l'église.</p>

          <div class="form-group">
            <label>Seriez-vous intéressé(e) pour participer à la chorale ?</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="chorale" value="oui">
                <span>Oui, avec plaisir !</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="chorale" value="non" checked>
                <span>Non, merci</span>
              </label>
            </div>
          </div>

          <div class="form-group">
            <label>Êtes-vous musicien(ne) ?</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="musician" value="oui">
                <span>Oui - Instrument : <input type="text" name="instrument" class="inline-input" placeholder="Précisez"></span>
              </label>
              <label class="radio-label">
                <input type="radio" name="musician" value="non" checked>
                <span>Non</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Transport -->
        <div class="form-section">
          <h2>Transport</h2>

          <div class="form-group">
            <label>Covoiturage</label>
            <div class="checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="covoiturage" value="propose">
                <span>Je propose des places dans ma voiture (nombre de places disponibles : <input type="number" name="places" min="1" max="8" class="inline-input inline-number">)</span>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" name="covoiturage" value="cherche">
                <span>Je cherche un covoiturage</span>
              </label>
              <label class="checkbox-label">
                <input type="checkbox" name="covoiturage" value="non-concerne">
                <span>Je ne suis pas concerné(e)</span>
              </label>
            </div>
            <p class="help-text">Si vous proposez ou cherchez un covoiturage, nous vous mettrons en relation avec d'autres invités</p>
          </div>

          <div class="form-group">
            <label for="ville">Ville de départ (si covoiturage)</label>
            <input type="text" id="ville" name="ville">
          </div>
        </div>

        <!-- Service de garde -->
        <div class="form-section">
          <h2>Service de garde d'enfants</h2>
          <div class="form-group">
            <label>Si une babysitter est mise à disposition pendant la soirée, seriez-vous intéressé(e) ?</label>
            <div class="radio-group">
              <label class="radio-label">
                <input type="radio" name="babysitter" value="oui">
                <span>Oui</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="babysitter" value="non">
                <span>Non</span>
              </label>
              <label class="radio-label">
                <input type="radio" name="babysitter" value="non-concerne" checked>
                <span>Je ne suis pas concerné(e)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Messages -->
        <div class="form-message form-error" id="formError" style="display:none;"></div>
        <div class="form-message form-success" id="formSuccess" style="display:none;">
          Merci pour votre réponse ! Nous avons bien reçu votre confirmation.
        </div>

        <div class="form-actions">
          <button type="submit" class="btn-submit">Envoyer ma réponse</button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  // Dynamic guest list
  const guestList = document.getElementById('guestList')!;
  const addGuestBtn = document.getElementById('addGuestBtn')!;
  let guestCount = 0;

  function createGuestRow() {
    guestCount++;
    const i = guestCount;
    const row = document.createElement('div');
    row.className = 'guest-row';
    row.dataset.index = String(i);
    row.innerHTML = `
      <div class="guest-row-header">
        <span class="guest-row-badge">${i}</span>
        <span class="guest-row-type-label">Adulte</span>
        <button type="button" class="btn-remove-guest" title="Supprimer">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div class="guest-row-fields">
        <div class="guest-field guest-field-type">
          <select name="guest-type-${i}" class="guest-type-select" required>
            <option value="adulte">Adulte</option>
            <option value="enfant">Enfant</option>
          </select>
        </div>
        <div class="guest-field guest-field-name">
          <input type="text" name="guest-prenom-${i}" required placeholder="Prénom">
        </div>
        <div class="guest-field guest-field-name">
          <input type="text" name="guest-nom-${i}" required placeholder="Nom">
        </div>
        <div class="guest-field guest-field-age" style="display:none;">
          <input type="number" name="guest-age-${i}" min="0" max="17" placeholder="Âge">
        </div>
        <div class="guest-field guest-field-menu" style="display:none;">
          <select name="guest-menu-${i}">
            <option value="">Menu</option>
            <option value="enfant">Menu enfant</option>
            <option value="adulte">Menu adulte</option>
          </select>
        </div>
      </div>
    `;

    // Type change handler
    const typeSelect = row.querySelector('.guest-type-select') as HTMLSelectElement;
    const ageField = row.querySelector('.guest-field-age') as HTMLElement;
    const menuField = row.querySelector('.guest-field-menu') as HTMLElement;
    const ageInput = row.querySelector(`[name="guest-age-${i}"]`) as HTMLInputElement;
    const typeLabel = row.querySelector('.guest-row-type-label') as HTMLElement;

    typeSelect.addEventListener('change', () => {
      const isChild = typeSelect.value === 'enfant';
      ageField.style.display = isChild ? 'flex' : 'none';
      menuField.style.display = 'none';
      typeLabel.textContent = isChild ? 'Enfant' : 'Adulte';
      row.classList.toggle('guest-row-child', isChild);
      if (!isChild) {
        ageInput.value = '';
      }
    });

    // Age change handler - show menu for 12-17
    ageInput.addEventListener('input', () => {
      const age = parseInt(ageInput.value) || 0;
      menuField.style.display = (age >= 12 && age <= 17) ? 'flex' : 'none';
    });

    // Remove button
    row.querySelector('.btn-remove-guest')!.addEventListener('click', () => {
      row.remove();
      renumberGuests();
    });

    guestList.appendChild(row);
  }

  function renumberGuests() {
    const rows = guestList.querySelectorAll('.guest-row');
    rows.forEach((row, idx) => {
      const badge = row.querySelector('.guest-row-badge');
      if (badge) badge.textContent = String(idx + 1);
    });
  }

  addGuestBtn.addEventListener('click', createGuestRow);

  // Add first guest row by default
  createGuestRow();

  const form = document.getElementById('rsvpForm') as HTMLFormElement;
  const errorEl = document.getElementById('formError')!;
  const successEl = document.getElementById('formSuccess')!;

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
    successEl.style.display = 'none';
    errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwV8Rz16CUuWFyTrnxe5kLieaNV7XccP_RhyLl_rPwfulC3glqqG-CX3uEVpDKFu54C/exec';

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.style.display = 'none';

      // Validation
      const guestRows = guestList.querySelectorAll('.guest-row');
      if (guestRows.length === 0) {
        showError('Veuillez ajouter au moins un invité.');
        return;
      }

      const events = document.querySelectorAll('input[name="events"]:checked');
      if (events.length === 0) {
        showError('Veuillez sélectionner au moins un événement.');
        return;
      }

      // Collect guest data
      const guests: any[] = [];
      guestRows.forEach((row) => {
        const idx = row.getAttribute('data-index');
        const type = (row.querySelector(`[name="guest-type-${idx}"]`) as HTMLSelectElement)?.value;
        const prenom = (row.querySelector(`[name="guest-prenom-${idx}"]`) as HTMLInputElement)?.value;
        const nom = (row.querySelector(`[name="guest-nom-${idx}"]`) as HTMLInputElement)?.value;
        const age = (row.querySelector(`[name="guest-age-${idx}"]`) as HTMLInputElement)?.value;
        const menu = (row.querySelector(`[name="guest-menu-${idx}"]`) as HTMLSelectElement)?.value;

        if (prenom && nom) {
          guests.push({ type, prenom, nom, age: age || '', menu: menu || '' });
        }
      });

      if (guests.length === 0) {
        showError('Veuillez remplir le prénom et nom de chaque invité.');
        return;
      }

      // Collect other fields
      const eventsArr = Array.from(events).map((el) => (el as HTMLInputElement).value);
      const dietary = (document.getElementById('dietary') as HTMLTextAreaElement)?.value || '';
      const chorale = (document.querySelector('input[name="chorale"]:checked') as HTMLInputElement)?.value || '';
      const musician = (document.querySelector('input[name="musician"]:checked') as HTMLInputElement)?.value || '';
      const instrument = (document.querySelector('[name="instrument"]') as HTMLInputElement)?.value || '';
      const carpooling = Array.from(document.querySelectorAll('input[name="carpooling"]:checked')).map((el) => (el as HTMLInputElement).value).join(', ');
      const carpoolSeats = (document.querySelector('[name="carpool-seats"]') as HTMLInputElement)?.value || '';
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';

      const payload = {
        guests,
        events: eventsArr,
        dietary,
        chorale,
        musician,
        instrument,
        carpooling,
        carpoolSeats,
        message
      };

      // Disable submit button
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Envoi en cours...';
      }

      try {
        await fetch(GOOGLE_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify(payload)
        });

        form.style.display = 'none';
        successEl.style.display = 'block';
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        showError('Une erreur est survenue. Veuillez réessayer ou nous contacter directement.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Envoyer ma réponse';
        }
      }
    });
  }
</script>

<style>
  .page-content { padding: 80px 20px; }

  .rsvp-form { max-width: 900px; margin: 0 auto; }

  .form-section {
    background: var(--color-white);
    padding: 40px;
    border-radius: 15px;
    margin-bottom: 30px;
    border: 2px solid var(--color-purple-light);
    border-top: 4px solid var(--color-lavender);
  }

  .form-section h2 {
    font-size: 24px;
    color: var(--color-dark);
    margin-bottom: 25px;
    font-family: var(--font-heading);
  }

  .form-group { margin-bottom: 25px; }

  .form-group label {
    display: block;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-dark);
    margin-bottom: 10px;
  }

  .form-group input[type="text"],
  .form-group textarea {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    font-size: 15px;
    font-family: var(--font-body);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    background: var(--color-white);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-lavender);
    box-shadow: 0 0 0 3px rgba(147, 136, 247, 0.15);
  }

  .form-group textarea { resize: vertical; min-height: 100px; }

  .checkbox-group,
  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .checkbox-label,
  .radio-label {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 14px 16px;
    border-radius: 10px;
    border: 2px solid transparent;
    transition: all 0.2s ease;
  }

  .checkbox-label:hover,
  .radio-label:hover {
    background: var(--color-beige);
    border-color: var(--color-purple-light);
  }

  .checkbox-label input[type="checkbox"],
  .radio-label input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    border: 2px solid #ccc;
    border-radius: 5px;
    margin-right: 14px;
    cursor: pointer;
    flex-shrink: 0;
    position: relative;
    transition: all 0.2s ease;
    background: var(--color-white);
  }

  .radio-label input[type="radio"] {
    border-radius: 50%;
  }

  .checkbox-label input[type="checkbox"]:checked,
  .radio-label input[type="radio"]:checked {
    background: var(--color-lavender);
    border-color: var(--color-lavender);
  }

  .checkbox-label input[type="checkbox"]:checked::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 2px;
    width: 6px;
    height: 12px;
    border: solid white;
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }

  .radio-label input[type="radio"]:checked::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: white;
  }

  .checkbox-label span,
  .radio-label span {
    font-size: 15px;
    color: var(--color-text);
  }

  .inline-input {
    width: auto;
    border: 2px solid #e0e0e0;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 14px;
    font-family: var(--font-body);
    transition: border-color 0.3s ease;
  }

  .inline-input:focus {
    outline: none;
    border-color: var(--color-lavender);
  }

  .inline-number { width: 70px; }


  .help-text {
    font-size: 14px;
    color: var(--color-text);
    font-style: italic;
    margin-top: 8px;
    margin-bottom: 8px;
  }

  .example-text {
    background: var(--color-beige);
    padding: 10px 15px;
    border-radius: 6px;
    font-style: normal;
    border-left: 3px solid var(--color-lavender);
  }

  .form-actions {
    text-align: center;
    padding-top: 20px;
  }

  .btn-submit {
    font-family: var(--font-nav);
    display: inline-block;
    padding: 18px 60px;
    background: var(--color-lavender);
    color: var(--color-white);
    font-size: 16px;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(147, 136, 247, 0.3);
  }

  .btn-submit:hover {
    background: var(--color-purple-dark);
    transform: translateY(-3px);
    box-shadow: 0 12px 35px rgba(138, 128, 208, 0.4);
  }

  .form-message {
    padding: 20px 30px;
    border-radius: 12px;
    font-size: 16px;
    margin-bottom: 20px;
    text-align: center;
  }

  .form-error {
    background: #fff0f0;
    color: #c00;
    border: 2px solid #fcc;
  }

  .form-success {
    background: var(--color-green-light);
    color: var(--color-dark);
    border: 2px solid var(--color-green);
    font-size: 20px;
    padding: 40px;
    font-family: var(--font-heading);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .form-section { padding: 30px 25px; }
  }
</style>

<style is:global>
  @keyframes guestSlideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .guest-row {
    background: white;
    border-radius: 14px;
    padding: 20px 22px;
    margin-bottom: 14px;
    border: 2px solid #eeecfc;
    animation: guestSlideIn 0.3s ease;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .guest-row:hover {
    border-color: var(--color-lavender);
    box-shadow: 0 4px 16px rgba(147, 136, 247, 0.1);
  }

  .guest-row-child {
    border-left: 4px solid var(--color-orange);
  }

  .guest-row-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .guest-row-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-lavender);
    color: white;
    font-weight: 600;
    font-size: 13px;
    flex-shrink: 0;
  }

  .guest-row-type-label {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
    flex: 1;
  }

  .btn-remove-guest {
    background: none;
    border: none;
    color: #bbb;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn-remove-guest:hover {
    color: var(--color-red);
    background: rgba(214, 0, 28, 0.06);
  }

  .guest-row-fields {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .guest-field {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .guest-field input,
  .guest-field select {
    padding: 10px 14px;
    border: 2px solid #e8e8e8;
    border-radius: 10px;
    font-size: 14px;
    font-family: var(--font-body);
    transition: border-color 0.3s, box-shadow 0.3s;
    background: #fafafa;
    color: var(--color-dark);
  }

  .guest-field input::placeholder {
    color: #bbb;
  }

  .guest-field input:focus,
  .guest-field select:focus {
    outline: none;
    border-color: var(--color-lavender);
    background: white;
    box-shadow: 0 0 0 3px rgba(147, 136, 247, 0.12);
  }

  .guest-field-type select,
  .guest-field-menu select {
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%23999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 12px center;
    padding-right: 32px;
  }

  .guest-field-type { flex: 0 0 120px; }
  .guest-field-name { flex: 1; min-width: 130px; }
  .guest-field-age { flex: 0 0 75px; }
  .guest-field-menu { flex: 0 0 140px; }
  .guest-field-age input { width: 100%; }

  .btn-add-guest {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(147, 136, 247, 0.05);
    border: 2px dashed var(--color-lavender);
    color: var(--color-purple-dark);
    padding: 14px 24px;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 500;
    font-family: var(--font-body);
    cursor: pointer;
    transition: all 0.25s ease;
    margin-top: 10px;
    width: 100%;
  }

  .btn-add-guest:hover {
    background: rgba(147, 136, 247, 0.12);
    border-color: var(--color-purple-dark);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .guest-row { padding: 16px; }
    .guest-row-fields {
      flex-direction: column;
      gap: 8px;
    }
    .guest-field-type,
    .guest-field-name,
    .guest-field-age,
    .guest-field-menu {
      flex: 1;
      width: 100%;
      min-width: 0;
    }
    .guest-field input,
    .guest-field select {
      width: 100%;
    }
  }
</style>
