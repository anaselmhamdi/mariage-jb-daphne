---
import CivilLayout from '../layouts/CivilLayout.astro';
---

<CivilLayout title="Mariage civil">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="hero-tag">Mariage civil</p>
        <h1 class="hero-names">
          Daphné<br>
          <span class="hero-amp">&amp;</span><br>
          Jean-Baptiste
        </h1>
        <p class="hero-date">Samedi 20 juin 2026</p>
        <p class="hero-location">Asnières-sur-Seine</p>
      </div>
      <div class="hero-illustration">
        <img
          src="/images/mairie-asnieres.png"
          alt="Mairie d'Asnières-sur-Seine"
          class="mairie-img"
          onerror="this.style.display='none'"
        />
      </div>
    </div>
  </section>

  <!-- PROGRAMME -->
  <section class="programme">
    <div class="container">
      <h2 class="section-title">Programme de la journée</h2>

      <div class="events">
        <div class="event-card">
          <img src="/images/civil-mairie.jpg" alt="Mairie d'Asnières-sur-Seine" class="event-photo" onerror="this.style.display='none'" />
          <p class="event-time">14h00</p>
          <h3 class="event-title">Cérémonie civile</h3>
          <p class="event-desc">Rendez-vous sur le parvis de la mairie<br>d'Asnières-sur-Seine</p>
          <p class="event-address">Place de l'Hôtel de Ville<br>92600 Asnières-sur-Seine</p>
          <a href="https://maps.google.com/?q=Mairie+Asnieres+sur+Seine+92600" target="_blank" class="btn-maps">Voir sur Google Maps</a>
        </div>

        <div class="event-divider">
          <span class="divider-line"></span>
          <span class="divider-dot">♡</span>
          <span class="divider-line"></span>
        </div>

        <div class="event-card">
          <img src="/images/civil-parc.jpg" alt="Parc de Voyer d'Argenson" class="event-photo" onerror="this.style.display='none'" />
          <p class="event-time">Photos &amp; 🥂</p>
          <h3 class="event-title">Parc de Voyer d'Argenson</h3>
          <p class="event-desc">À 6-7 min à pied de la mairie</p>
          <p class="event-address">89 Rue du Château<br>92600 Asnières-sur-Seine</p>
          <p class="event-note">Rejoignez les Halles Flachat en voiture,<br>ou à pied depuis le parc <span class="note-walk">~24 min</span></p>
        </div>

        <div class="event-divider">
          <span class="divider-line"></span>
          <span class="divider-dot">♡</span>
          <span class="divider-line"></span>
        </div>

        <div class="event-card">
          <img src="/images/civil-halle.jpg" alt="Halle Flachat" class="event-photo" onerror="this.style.display='none'" />
          <p class="event-time">17h30</p>
          <h3 class="event-title">Apéro dînatoire · esprit guinguette</h3>
          <p class="event-desc">Halle Flachat · Terrasse<br>Asnières-sur-Seine</p>
          <p class="event-desc" style="font-size:16px; margin-top: 6px;">Soirée festive jusqu'à minuit 💃</p>
          <p class="event-note">Le lieu n'est pas entièrement privatisé,<br>d'autres personnes seront présentes sur place.</p>
          <p class="event-address">14 Rue Henri Martin<br>92600 Asnières-sur-Seine</p>
          <a href="https://maps.google.com/?q=14+Rue+Henri+Martin+92600+Asnieres-sur-Seine" target="_blank" class="btn-maps">Voir sur Google Maps</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ACCÈS -->
  <section class="acces">
    <div class="container">
      <h2 class="section-title">Comment venir ?</h2>
      <div class="acces-grid">

        <div class="acces-block">
          <p class="acces-block-title">🚇 Transports en commun</p>
          <p class="acces-subgroup" style="margin-top:0">Cérémonie civile — Mairie</p>
          <ul class="acces-list">
            <li><strong>Transilien J / L</strong> — Gare d'Asnières-sur-Seine <span class="acces-detail">(depuis Paris Saint-Lazare · 5 min à pied)</span></li>
            <li><strong>Métro ligne 13</strong> — Asnières-Gennevilliers Les Courtilles <span class="acces-detail">(10 min à pied)</span></li>
            <li><strong>Bus</strong> — Lignes 54, 138, 167 · Arrêt Hôtel de Ville</li>
          </ul>
        </div>

        <div class="acces-block acces-block-parking">
          <p class="acces-block-title">🅿️ Parkings à proximité</p>

          <p class="acces-subgroup">Cérémonie civile — Mairie</p>
          <ul class="acces-list">
            <li>
              <a href="https://www.indigoneo.fr/fr/parkings/23761/parking-hotel-de-ville" target="_blank" class="acces-link">Parking Hôtel de Ville <span class="acces-places">250 places</span></a>
              <span class="acces-detail">2 Place Aristide Briand — 92600 Asnières-sur-Seine</span>
            </li>
            <li>
              <a href="https://www.effia.com/parking/parking-asnieres-sur-seine-concorde-i-effia" target="_blank" class="acces-link">Parking Concorde 1 <span class="acces-places">240 places</span></a>
              <span class="acces-detail">11 Rue de la Concorde — 92600 Asnières-sur-Seine</span>
            </li>
            <li>
              <a href="https://www.effia.com/parking/parking-asnieres-sur-seine-concorde-ii-effia" target="_blank" class="acces-link">Parking Concorde 2 <span class="acces-places">170 places</span></a>
              <span class="acces-detail">25 Rue de la Concorde — 92600 Asnières-sur-Seine</span>
            </li>
          </ul>

          <p class="acces-subgroup">Cocktail — Halle Flachat</p>
          <ul class="acces-list">
            <li>
              <a href="https://www.effia.com/parking/parking-asnieres-sur-seine-flachat-effia" target="_blank" class="acces-link">Parking Flachat <span class="acces-places">120 places</span></a>
              <span class="acces-detail">20 Rue Benoît Malon — 92600 Asnières-sur-Seine</span>
            </li>
            <li>
              <a href="https://www.effia.com/parking/parking-asnieres-sur-seine-bruyeres-effia" target="_blank" class="acces-link">Parking Des Bruyères <span class="acces-places">110 places</span></a>
              <span class="acces-detail">7 Rue Roger Campestre — 92600 Asnières-sur-Seine</span>
            </li>
          </ul>

          <ul class="acces-list acces-list-footer">
            <li class="acces-free">✓ Stationnement gratuit le samedi <span class="acces-detail">(sauf zones verte et rouge)</span></li>
            <li>
              <a href="https://asnieres-sur-seine.fr/fileadmin/Medias_et_documents/Securite-prevention/Plaquette_stationnement_Mise_a_jour_Avril_2026_A4.pdf" target="_blank" class="acces-link">Guide officiel du stationnement à Asnières</a>
              <span class="acces-detail">Mise à jour avril 2026</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="civil-footer">
    <p class="footer-names">Daphné &amp; Jean-Baptiste</p>
    <p class="footer-date">20 juin 2026 · Asnières-sur-Seine</p>
    <p class="footer-copy">&copy; 2026 Daphné &amp; Jean-Baptiste · Tous droits réservés</p>
  </footer>

</CivilLayout>

<style>
  /* ---- PALETTE ILLUSTRATION ---- */
  :root {
    --civil-sky: #B8D8EA;
    --civil-sky-light: #DDF0F9;
    --civil-navy: #2A3655;
    --civil-navy-light: #3D4F72;
    --civil-cream: #F7F0E5;
    --civil-sand: #EAD9BE;
    --civil-green: #7AAF5E;
    --civil-rose: #CC8088;
    --civil-white: #FDFAF6;
  }

  /* ---- HERO ---- */
  .hero {
    background: linear-gradient(160deg, var(--civil-sky-light) 0%, var(--civil-cream) 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 60px 40px;
  }

  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 60px;
    flex-direction: row-reverse;
  }

  .hero-text {
    flex: 1;
  }

  .hero-tag {
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--civil-navy);
    border: 1.5px solid var(--civil-navy);
    display: inline-block;
    padding: 6px 18px;
    border-radius: 20px;
    margin-bottom: 30px;
    opacity: 0.75;
  }

  .hero-names {
    font-family: var(--font-heading);
    font-size: clamp(52px, 8vw, 96px);
    font-weight: 500;
    font-style: italic;
    color: var(--civil-navy);
    line-height: 1.0;
    margin-bottom: 28px;
  }

  .hero-amp {
    font-size: 0.7em;
    color: var(--civil-rose);
  }

  .hero-date {
    font-family: var(--font-nav);
    font-size: clamp(14px, 2vw, 17px);
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--civil-navy);
    margin-bottom: 8px;
    opacity: 0.8;
  }

  .hero-location {
    font-family: var(--font-nav);
    font-size: clamp(12px, 1.5vw, 14px);
    font-weight: 400;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--civil-green);
  }

  .hero-illustration {
    flex: 0 0 500px;
    display: flex;
    justify-content: center;
  }

  .mairie-img {
    width: 100%;
    max-width: 500px;
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(42, 54, 85, 0.14);
  }

  /* ---- PROGRAMME ---- */
  .programme {
    padding: 100px 40px;
    background: var(--civil-white);
  }

  .container {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 500;
    font-style: italic;
    color: var(--civil-navy);
    margin-bottom: 60px;
  }

  .events {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .event-card {
    text-align: center;
    padding: 40px 20px;
  }

  .event-photo {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto 20px;
    display: block;
    box-shadow: 0 8px 24px rgba(42, 54, 85, 0.15);
    border: 3px solid var(--civil-white);
  }

  .event-time {
    font-family: var(--font-heading);
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 400;
    font-style: italic;
    color: var(--civil-rose);
    line-height: 1;
    margin-bottom: 12px;
  }

  .event-title {
    font-family: var(--font-nav);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--civil-navy);
    margin-bottom: 14px;
  }

  .event-desc {
    font-family: var(--font-heading);
    font-size: clamp(18px, 2.5vw, 22px);
    font-style: italic;
    color: var(--civil-navy);
    opacity: 0.75;
    line-height: 1.6;
  }

  .event-address {
    font-family: var(--font-nav);
    font-size: 13px;
    font-style: normal;
    color: var(--civil-navy);
    opacity: 0.55;
    line-height: 1.7;
    margin-top: 10px;
    letter-spacing: 0.3px;
  }

  .note-walk {
    font-weight: 600;
    color: var(--civil-navy);
    opacity: 1;
  }

  .btn-maps {
    display: inline-block;
    margin-top: 12px;
    padding: 7px 18px;
    border: 1.5px solid var(--civil-navy);
    color: var(--civil-navy);
    text-decoration: none;
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    border-radius: 20px;
    opacity: 0.6;
    transition: all 0.2s ease;
  }

  .btn-maps:hover {
    opacity: 1;
    background: var(--civil-navy);
    color: var(--civil-white);
  }

  .event-note {
    margin: 16px auto 0;
    font-family: var(--font-nav);
    font-size: 12px;
    color: var(--civil-navy);
    opacity: 0.6;
    line-height: 1.7;
    background: var(--civil-sand);
    padding: 10px 20px;
    border-radius: 8px;
    display: block;
  }

  .event-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 200px;
    margin: 8px auto;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: var(--civil-rose);
    opacity: 0.4;
  }

  .divider-dot {
    color: var(--civil-rose);
    font-size: 16px;
    opacity: 0.7;
  }

  /* ---- ACCÈS ---- */
  .acces {
    padding: 80px 40px;
    background: linear-gradient(160deg, var(--civil-sky-light) 0%, var(--civil-cream) 100%);
    text-align: center;
  }

  .acces-address {
    font-size: 16px;
    color: var(--civil-navy);
    opacity: 0.75;
    line-height: 1.8;
    margin-bottom: 30px;
    font-style: italic;
  }

  .acces-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
    text-align: left;
  }

  .acces-block {
    background: var(--civil-white);
    border-radius: 16px;
    padding: 24px 28px;
    box-shadow: 0 4px 20px rgba(42, 54, 85, 0.07);
  }

  .acces-block-title {
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--civil-navy);
    margin-bottom: 16px;
  }

  .acces-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .acces-list li {
    font-size: 14px;
    color: var(--civil-navy);
    opacity: 0.85;
    line-height: 1.5;
  }

  .acces-detail {
    display: block;
    font-size: 12px;
    opacity: 0.6;
    font-style: italic;
    margin-top: 2px;
  }

  .acces-subgroup {
    font-family: var(--font-nav);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--civil-rose);
    margin: 14px 0 8px;
    opacity: 0.9;
  }

  .acces-subgroup:first-of-type {
    margin-top: 0;
  }

  .acces-list-footer {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(42, 54, 85, 0.08);
  }

  .acces-places {
    font-size: 11px;
    font-style: normal;
    background: var(--civil-sky);
    color: var(--civil-navy);
    padding: 1px 7px;
    border-radius: 10px;
    margin-left: 6px;
    font-weight: 600;
    opacity: 0.85;
  }

  .acces-link {
    color: var(--civil-navy);
    text-decoration: underline;
    text-decoration-color: var(--civil-sky);
    text-underline-offset: 3px;
    transition: color 0.2s;
  }

  .acces-link:hover {
    color: var(--civil-rose);
  }

  .acces-free {
    color: var(--civil-green) !important;
    opacity: 1 !important;
    font-weight: 500;
  }

  .btn-map {
    display: inline-block;
    padding: 16px 40px;
    background: var(--civil-navy);
    color: var(--civil-white);
    text-decoration: none;
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-radius: 50px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 25px rgba(42, 54, 85, 0.2);
  }

  .btn-map:hover {
    background: var(--civil-rose);
    transform: translateY(-2px);
  }

  /* ---- FOOTER ---- */
  .civil-footer {
    padding: 50px 20px;
    text-align: center;
    background: var(--civil-navy);
  }

  .footer-names {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 500;
    font-style: italic;
    color: var(--civil-white);
    margin-bottom: 8px;
  }

  .footer-date {
    font-family: var(--font-nav);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--civil-sky);
  }

  .footer-copy {
    font-family: var(--font-nav);
    font-size: 11px;
    font-weight: 400;
    color: var(--civil-sky);
    opacity: 0.5;
    margin-top: 16px;
    letter-spacing: 0.5px;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .hero { min-height: auto; padding: 60px 30px; }
    .hero-inner { flex-direction: column; gap: 40px; text-align: center; }
    .hero-illustration { flex: none; width: 100%; }
    .mairie-img { max-width: 420px; }
  }

  @media (max-width: 600px) {
    .hero { padding: 50px 20px; }
    .programme { padding: 60px 20px; }
    .acces { padding: 60px 20px; }
    .event-card { padding: 28px 10px; }
    .event-note { font-size: 11px; }
    .acces-grid { grid-template-columns: 1fr; gap: 16px; }
    .acces-block { padding: 20px; }
  }
</style>
